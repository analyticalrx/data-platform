{
    "TransitionDefaultMinimumObjectSize": "all_storage_classes_128K",
    "Rules": [
        {
            "ID": "archive-processed-reports",
            "Filter": {
                "And": {
                    "Prefix": "incoming/",
                    "Tags": [
                        {
                            "Key": "processed",
                            "Value": "true"
                        }
                    ],
                    "ObjectSizeGreaterThan": 0
                }
            },
            "Status": "Enabled",
            "Transitions": [
                {
                    "Days": 0,
                    "StorageClass": "GLACIER"
                }
            ]
        }
    ]
}
